@startuml ClassDiagram
allowmixing
title Weeks 4–5 — current Todo App
skinparam classAttributeIconSize 0
hide empty members

class TodoService {
  + storage: load/save contract
  + tasks: Array<Object>
  + TodoService(storage)
  + addTask(description, type): number | null
  + toggleComplete(id)
  + deleteTask(id)
  + getWorkloadSummary(): String
}
class TodoRenderer {
  + container: HTMLElement
  + actions: Object
  + TodoRenderer(containerId)
  + bindActions(actions)
  + renderPendingRows(service): String
  + renderCompletedRows(service): String
  + render(service, justAddedId)
}
class TodoController {
  + todoService: TodoService
  + todoRenderer: TodoRenderer
  + TodoController(todoService, todoRenderer)
  + start()
  + addTask(description, type): number | null
  + toggleTask(id)
  + deleteTask(id)
}
class LocalStorageHandler {
  + load(): Array<Object>
  + save(tasks)
}
interface "Storage contract" as Storage <<structural contract>> {
  + load(): Array<Object>
  + save(tasks)
}
rectangle "main.js" as Main <<composition root>>
rectangle "Row markup helper\nbuildTaskRow(...)" as Rows <<free function>>
rectangle "onToggle(id) / onDelete(id)" as Actions <<bound callbacks>>
rectangle "Task container / document" as DOM <<browser API>>
rectangle "localStorage" as BrowserStorage <<browser API>>

Main ..> LocalStorageHandler : creates
Main ..> TodoService : injects storage
Main ..> TodoRenderer : provides container id
Main ..> TodoController : injects service and renderer
TodoController --> TodoService : holds injected reference
TodoController --> TodoRenderer : holds injected reference
TodoService --> Storage : holds injected storage
LocalStorageHandler ..|> Storage : satisfies load/save shape
LocalStorageHandler ..> BrowserStorage : reads / writes todo-tasks
TodoRenderer ..> TodoService : reads tasks and summary during render
TodoRenderer --> DOM : keeps existing element reference
TodoRenderer ..> Rows : builds row markup
TodoController ..> Actions : supplies bound functions
TodoRenderer --> Actions : stores and invokes
Actions ..> TodoController : delegate toggleTask / deleteTask

note left of Storage
  Conceptual JavaScript structural contract.
  No interface declaration or inheritance
  appears in the source. Any object with
  load() and save(tasks) can be injected.
end note
note left of TodoService
  Owns the array and creates plain task records:
  id, desc, completed, priority, createdAt.
  There is no Task class.
  The urgent conditional remains for Week 6.
end note
note bottom of TodoRenderer
  Calls supplied functions, not a controller reference.
  The controller and renderer do not require each other
  to be constructed first. Renderer never mutates service.
end note
note bottom of TodoController
  Injected references are associations, not composition:
  main.js constructs the dependencies independently.
  Controller delegates domain rules and requests redraws.
end note
@enduml
